# --- Oracle (backend) ---
# Obligatorio en producción. También acepta SCSE_DB_PASSWD por compatibilidad local.
DB_PASSWORD=

# Opcionales: docker-compose ya define host/puerto/servicio/usuario por defecto.
# DB_HOST=160.2.1.79
# DB_PORT=1521
# DB_SERVICE=Ligapru
# DB_USER=onco

# Alternativa legacy (backend/database.py):
# SCSE_DB_USER=onco
# SCSE_DB_PASSWD=
# SCSE_DB_IP=160.2.1.79
# SCSE_DB_PORT=1521
# SCSE_DB_DATABASE=Ligapru

# --- JWT (backend) ---
JWT_SECRET=cambiar_por_secreto_largo_en_produccion

# --- Frontend (build-time Vite) ---
# En Docker use ruta relativa: el proxy Nginx reenvía /api al backend.
VITE_API_URL=/api

# Desarrollo local sin Docker (npm run dev):
# VITE_API_URL=http://localhost:8000/api